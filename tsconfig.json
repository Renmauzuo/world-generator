{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["ES2017", "DOM"],
    "module": "ES2015",
    "moduleResolution": "node",
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "docs/scripts",
    "rootDir": "src/scripts",
    "sourceMap": true
  },
  "include": ["src/scripts/**/*.ts"],
  "exclude": [
    "node_modules",
    "src/scripts/**/*.test.ts",
    "src/scripts/**/*.spec.ts",
    "src/scripts/**/__tests__/**"
  ]
}
