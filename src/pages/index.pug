doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        title World Generator
    link(rel="stylesheet" type="text/css" href="styles/styles.min.css")
    body
        #control-panel.container.panel
            button#button-generate-new Generate New World
            br
            label(for="starting-node") Starting with:
            select#starting-node
                option(value="multiverse") Multiverse
                option(value="plane") Plane
                option(value="materialPlane") Material Plane
                option(value="planet") Planet
            label#preset-label(for="load-preset") Load preset:
            select#load-preset
            label#load-label(for="load-saved") Load saved:
            select#load-saved
            br
            button#button-import-root Import
            br
            button#button-export-root Export
            button#button-export-root-players Export (Players)
            br
            button#button-save Save
        #generation-container.container

        #info-panel.container.panel
            h2
            label(for="name") Name:
            input(type="text" id="name")
            br
            label.gm-only-label(for="gm-only")
                input(type="checkbox" id="gm-only")
                |  GM Only

            #fields
            button#button-import-selected Import Child
            br
            button#button-export-selected Export
            button#button-export-selected-players Export (Players)
            br
            button#button-delete-selected Delete

        #statblock-modal
            .statblock-modal-content
                button#statblock-modal-close ✕
                #statblock-modal-body
        script(src="https://code.jquery.com/jquery-3.4.1.min.js" integrity="sha256-CSXorXvZcTkaix6Yvo6HppcZGetbYMGWSFlBw8HfCJo=" crossorigin="anonymous")
        script(src="scripts/scripts.min.js")